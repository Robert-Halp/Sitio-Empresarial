# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# --- Públicos (seguros en el navegador si RLS está activo) ---
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_ANON_KEY=""

# --- Privado (solo servidor / scripts locales) ---
# NUNCA lo expongas en el frontend ni lo subas al repo.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Conexión directa a Postgres (opcional, para migraciones/psql) ---
# Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=""
